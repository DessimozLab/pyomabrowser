# Environment for cloudflare_load_guard.py — copy to cloudflare_load_guard.env,
# fill in the values below, and source it from cron (see Readme.md,
# "Cloudflare load-based challenge"). Keep the filled-in copy out of git.

# --- Cloudflare API ---

# Scoped API token: My Profile -> API Tokens -> Create Token -> "Edit zone WAF"
# template, restricted to the omabrowser.org zone only.
CF_API_TOKEN=

# Zone ID: Cloudflare dashboard -> select the domain -> Overview, right sidebar.
CF_ZONE_ID=

# The custom ruleset and rule to toggle. Create the rule first in
# Security -> WAF -> Custom rules (action: Managed Challenge, matching the
# URI paths to protect, saved DISABLED), then find the IDs with:
#   curl -s -H "Authorization: Bearer $CF_API_TOKEN" \
#     "https://api.cloudflare.com/client/v4/zones/$CF_ZONE_ID/rulesets/phases/http_request_firewall_custom/entrypoint"
CF_RULESET_ID=
CF_RULE_ID=

# --- Local log monitoring ---

# Path to the nginx access log on this host (must be the default combined
# format; this is the production host, not the dockerized dev setup).
CF_GUARD_ACCESS_LOG=/var/log/nginx/access.log

# Where to persist the log read offset and hysteresis counters between runs.
#CF_GUARD_STATE_FILE=/var/tmp/cloudflare_load_guard.state.json

# Optional regex against the raw request line ("GET /api/foo HTTP/1.1"). Only
# matching lines count toward the load calculation. Leave unset to count all
# traffic. Set this to match the paths the WAF rule protects if you want the
# trigger scoped to just that traffic (e.g. '^\S+ /api/').
#CF_GUARD_PATH_FILTER=

# Requests/sec (averaged over the time since the previous run) at/above which
# a window counts as "elevated". Tune against this server's normal traffic —
# there is no safe universal default.
#CF_GUARD_RPS_HIGH=50

# Requests/sec at/below which a window counts as "calm".
#CF_GUARD_RPS_LOW=20

# Fraction of requests in the window returning 429/5xx at/above which a
# window counts as "elevated", regardless of raw request rate — catches the
# "backend is struggling" case even at moderate traffic.
#CF_GUARD_ERROR_RATE_HIGH=0.2

# Median $request_time (seconds) at/above which a window counts as
# "elevated" — often the earliest sign of a struggling backend, ahead of
# any 5xx/429s. Requires the log_format to emit rt=$request_time (see
# Readme.md, "Cloudflare load-based challenge"); leave unset to
# disable this trigger entirely (e.g. before that log_format change ships).
#CF_GUARD_LATENCY_HIGH=

# Minimum requests in a window before the error-rate/latency triggers are
# trusted (avoids one slow or failed request out of two looking like a crisis).
#CF_GUARD_MIN_SAMPLE=20

# Consecutive elevated windows required before enabling the rule, and
# consecutive calm windows required before disabling it again. Asymmetric on
# purpose: quick to turn on, slower to turn back off.
#CF_GUARD_CONSECUTIVE_ON=3
#CF_GUARD_CONSECUTIVE_OFF=5

# Set to true to log the decision without ever calling the Cloudflare API —
# useful for tuning thresholds against real traffic before trusting it.
#CF_GUARD_DRY_RUN=false
