{{- $BEHIND_PROXY := getenv "REVERSE_PROXY_IP" | ne "" }}
{{- $log_rate_limit_file := getenv "LOG_RATE_LIMIT_FILE" }}
{{- $user_agent_bot_file := getenv "USER_AGENT_BOT_FILE" }}
{{- $subnet_bot_file := getenv "SUBNET_BOT_FILE" }}
{{- $nginx_snippet_path := getenv "NGINX_SNIPPET_PATH" "/etc/nginx/snippets" }}
{{- $THROTTLED := or ($log_rate_limit_file | ne "") (or ($user_agent_bot_file | ne "") ($subnet_bot_file | ne "")) }}
{{- $is_dev := eq ((getenv "DEPLOYMENT_TYPE") | strings.ToUpper | strings.Trunc 3) "DEV" }}
{{- $log_to_file := getenv "NGINX_LOG_TO_FILE" | default "false" | conv.ToBool }}
{{- $kc_issuer := getenv "OAUTH2_PROXY_OIDC_ISSUER_URL" }}
{{- $kc_client_id := getenv "OAUTH2_PROXY_CLIENT_ID" }}
{{- $kc_client_secret := getenv "OAUTH2_PROXY_CLIENT_SECRET" }}
{{- $api_anon_rate := getenv "API_ANON_RATE_LIMIT" "10r/m" }}
{{- $api_anon_burst := getenv "API_ANON_RATE_BURST" "5" }}
{{- $api_anon_global_rate := getenv "API_ANON_GLOBAL_RATE_LIMIT" "300r/m" }}
{{- $api_anon_global_burst := getenv "API_ANON_GLOBAL_RATE_BURST" "20" }}
{{- $api_auth_rate := getenv "API_AUTH_RATE_LIMIT" "120r/m" }}
{{- $api_auth_burst := getenv "API_AUTH_RATE_BURST" "20" }}

upstream pyoma {
    server web:8000;
}

# /api/ rate-limit zones (independent of the bot UA/subnet throttle below):
#  - api_anon_limit:        per-source-IP cap for unauthenticated callers
#  - api_anon_global_limit: shared cap across ALL unauthenticated callers, since a
#                            distributed crawler using many source IPs (observed:
#                            ~26k distinct IPs, 97.7% firing a single request each)
#                            defeats a per-IP cap almost entirely
#  - api_auth_limit:        per-credential cap for authenticated (Keycloak) callers.
#                            Keyed on the raw credential presented on the ORIGINAL
#                            request ($http_authorization / the oauth2-proxy session
#                            cookie), not on $auth_user: auth_request_set variables
#                            are only resolved in the access phase, which runs AFTER
#                            limit_req's preaccess phase, so a zone keyed on $auth_user
#                            would always see it empty and never actually limit anyone.
map $request_uri $api_anon_global_key {
    default "anon";   # constant key => every anonymous request shares one bucket
}

# Website AJAX (fetch()/XHR) is same-origin AND uses a fetch/XHR Sec-Fetch-Mode.
# Direct navigation to an /api/ URL is also same-origin but uses Sec-Fetch-Mode:
# navigate — that pattern turned out to be how a distributed crawler was reaching
# /api/ un-throttled (it genuinely navigates from omabrowser.org to omabrowser.org,
# so sec-fetch-site: same-origin is not spoofed, just not what this check is meant
# to exempt), so both headers are required, not just sec-fetch-site.
map "$http_sec_fetch_site:$http_sec_fetch_mode" $is_website_ajax {
    default                    0;
    "same-origin:cors"        1;
    "same-origin:same-origin" 1;
}

# Key for the authenticated-tier zone: forced empty (=> unlimited) for website AJAX
# regardless of whether the visitor also happens to be logged in (their session
# cookie must not count against them here); otherwise the caller's own bearer
# token / oauth2-proxy session cookie, so each credential gets its own bucket.
# An empty value here (no credential presented, not website AJAX) is harmless:
# auth_request will 401 that request anyway and it falls through to @api_anon.
map $is_website_ajax $api_auth_key {
    1       "";
    default "$http_authorization$cookie__oauth2_proxy";
}

limit_req_zone $binary_remote_addr  zone=api_anon_limit:10m        rate={{ $api_anon_rate }};
limit_req_zone $api_anon_global_key zone=api_anon_global_limit:1m  rate={{ $api_anon_global_rate }};
limit_req_zone $api_auth_key        zone=api_auth_limit:10m        rate={{ $api_auth_rate }};

# Audit log for the same-origin bypass on /api/: records the Fetch Metadata
# headers the auth decision at /_auth_check relies on, plus the resolved
# auth user/status, so we can see how many requests actually send them.
log_format auth_audit escape=json
    '{"time":"$time_iso8601","remote_addr":"$remote_addr","method":"$request_method",'
    '"uri":"$request_uri","status":$status,"sec_fetch_site":"$http_sec_fetch_site",'
    '"sec_fetch_mode":"$http_sec_fetch_mode","origin":"$http_origin","referer":"$http_referer",'
    '"user_agent":"$http_user_agent","auth_user":"$auth_user"}';

# Same as nginx's default "combined" format, plus rt=$request_time so tools
# like cloudflare_load_guard.py can track response-time trends (not present
# in "combined", so it has to be spelled out here).
log_format main_rt '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" rt=$request_time';

{{ if $BEHIND_PROXY }}
# pass incoming X-Forwarded-Proto or set to $scheme
map $http_x_forwarded_proto $proxyproto {
    default     $http_x_forwarded_proto;
    ""          $scheme;
}
{{ end }}

{{- if $THROTTLED }}
# Configure limit zones
limit_req_zone $bot_throttle_key zone=bot_limit:5m rate=6r/m;
limit_req_zone $subnet_key zone=subnet_limit:5m rate=6r/m;

map $http_user_agent $bot_throttle_key {
    default            "";         # Not a bot → no limit
    {{ $ua_file := printf "%s/%s"  $nginx_snippet_path  $user_agent_bot_file }}
    {{- if (file.Exists $ua_file) }}
    include    {{ $ua_file }};
    {{- end }}
}

geo $subnet_key {
    default         "";
    {{ $sb_file := printf "%s/%s"  $nginx_snippet_path $subnet_bot_file }}
    {{- if (file.Exists $sb_file) }}
    include    {{ $sb_file }};
    {{- end }}
    {{- if $log_rate_limit_file }}
    {{ $al_file := printf "%s/%s"  $nginx_snippet_path $log_rate_limit_file }}
    {{- if (file.Exists $al_file) }}
    include   {{ $al_file }};
    {{- end }}
    {{- end }}
}


map $request_uri $is_exempt_path {
    default                     0;
    ~^/oma/domains/[^/]+/json/  1;    # exclude domain json requests from throttling
}

map $bot_throttle_key $is_known_bot {
    ""      0;
    default 1;
}

map $subnet_key $is_throttle_subnet {
    ""      0;
    default 1;
}


map "$is_known_bot|$is_exempt_path|$is_throttle_subnet" $should_throttle {
    default   0;
    "1|0|0"   1;  # Bot AND not exempted → throttle
    "1|0|1"   1;  # Bot AND not exempted AND BadSubnet → throttle
    "0|0|1"   1;  # BadSubnet → throttle
    "0|1|1"   1;  # exempted AND BadSubnet → throttle
    "1|1|1"   1;  # Bot AND exempted AND BadSubnet → throttle
}
{{- end }}


server {
    listen 80;
    server_tokens off;

    # /api/ chains two error_page redirects for anonymous, rate-limited callers
    # (401 -> @api_anon, then a 429 from @api_anon's own limit_req -> @api_rate_limited).
    # Without this, the second redirect is silently ignored (nginx's default is
    # to allow only one error_page redirect per request) and nginx serves its
    # plain built-in error page instead of the JSON body.
    recursive_error_pages on;

    {{ if $BEHIND_PROXY -}}
    # set proxy headers if run behind external proxy
    set_real_ip_from {{ getenv "REVERSE_PROXY_IP" }};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    {{- end }}

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    {{- if $BEHIND_PROXY }}
    proxy_set_header X-Forwarded-Proto $proxyproto;
    {{- else }}
    proxy_set_header X-Forwarded-Proto $scheme;
    {{- end }}

    # allow to upload files up to 55MB
    client_max_body_size 55M;

    # redirect / to home page
    rewrite ^/$ /oma/home/ permanent;
    rewrite ^/index.html$ /oma/home/ permanent;

    proxy_intercept_errors on;

    {{- if not $is_dev }}
    error_page   500 503 504  /50x.html;
    error_page   502          /502.html;
    error_page   429          /429.html;
    {{- end }}

    {{- if $log_to_file }}
    access_log /var/log/nginx/access.log main_rt;
    error_log  /var/log/nginx/error.log warn;
    {{- end }}
    access_log /dev/stdout main_rt;
    error_log  /dev/stderr {{ if $is_dev -}} info {{- else -}} warn {{- end }};

    # Public token proxy: injects client credentials server-side for device flow
    location = /api/auth/device {
        proxy_pass {{ $kc_issuer }}/protocol/openid-connect/auth/device;
        proxy_set_header Content-Type "application/x-www-form-urlencoded";
        proxy_set_body "client_id={{ $kc_client_id }}&client_secret={{ $kc_client_secret }}";
        proxy_ssl_server_name on;
    }

    location = /api/auth/token {
        proxy_pass {{ $kc_issuer }}/protocol/openid-connect/token;
        proxy_set_header Content-Type "application/x-www-form-urlencoded";
        proxy_set_body "$request_body&client_id={{ $kc_client_id }}&client_secret={{ $kc_client_secret }}";
        proxy_ssl_server_name on;
    }

    # oauth2-proxy sign-in flow and callbacks
    location /oauth2/ {
        proxy_pass http://oauth2-proxy:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    # Internal auth check: passes real website AJAX ($is_website_ajax, see the map
    # above — same-origin AND a fetch/XHR Sec-Fetch-Mode, not a navigation),
    # forwards all other requests to oauth2-proxy for authentication.
    # Note: auth_request requires a literal URI, so the branching logic lives here.
    location = /_auth_check {
        internal;
        if ($is_website_ajax) {
            return 200;
        }
        proxy_pass http://oauth2-proxy:4180/oauth2/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Public website pages — always accessible
    location ~ ^/oma/ {
        {{- if $THROTTLED }}
        if ($should_throttle)  {
            return 418;
        }
        {{- end }}
        proxy_pass http://pyoma;
        proxy_redirect off;
        uwsgi_read_timeout 100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Auth-Request-User $http_x_auth_request_user;
        proxy_set_header X-Auth-Request-Email $http_x_auth_request_email;
    }

    # REST API, four tiers:
    #  1. website AJAX ($is_website_ajax)      — passes freely, no rate limit
    #  2. authenticated (Keycloak session/token) — generous per-credential limit (api_auth_limit)
    #  3+4. anonymous (no valid session/token)  — served, not blocked, at a strict
    #       per-IP + global limit (@api_anon), replacing the old hard 401/sign-in-redirect
    # To make specific cheap endpoints public in the future, add a location block for
    # them above this one without auth_request (more-specific regex takes precedence).
    location ~ ^/api/ {
        {{- if $THROTTLED }}
        if ($should_throttle)  {
            return 418;
        }
        {{- end }}
        auth_request /_auth_check;
        auth_request_set $auth_user  $upstream_http_x_auth_request_user;
        auth_request_set $auth_email $upstream_http_x_auth_request_email;
        error_page 401 = @api_anon;
        error_page 429 = @api_rate_limited;
        limit_req zone=api_auth_limit burst={{ $api_auth_burst }} nodelay;
        limit_req_status 429;
        access_log /dev/stdout;
        access_log /dev/stdout auth_audit;
        proxy_pass http://pyoma;
        proxy_redirect off;
        uwsgi_read_timeout 100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Auth-Request-User  $auth_user;
        proxy_set_header X-Auth-Request-Email $auth_email;
    }

    # Anonymous tier: no valid Keycloak session/token, and not website AJAX.
    # Served (not blocked) at a strict rate instead of the old 401/sign-in-redirect,
    # so casual anonymous API use still works — just capped hard. Two zones apply:
    # a per-IP cap for individual repeat offenders, and a global cap shared across
    # all anonymous callers, since a distributed crawler (many source IPs, most
    # firing once) defeats a per-IP cap alone.
    location @api_anon {
        internal;
        error_page 429 = @api_rate_limited;
        limit_req zone=api_anon_limit        burst={{ $api_anon_burst }}        nodelay;
        limit_req zone=api_anon_global_limit burst={{ $api_anon_global_burst }} nodelay;
        limit_req_status 429;
        access_log /dev/stdout;
        access_log /dev/stdout auth_audit;
        proxy_pass http://pyoma;
        proxy_redirect off;
        uwsgi_read_timeout 100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location @api_rate_limited {
        internal;
        default_type application/json;
        return 429 '{"detail":"Rate limit exceeded. Log in for a higher limit."}';
    }

    location = /cgi-bin/gateway.pl {
        proxy_pass http://pyoma;
        proxy_redirect off;
        uwsgi_read_timeout 3;
    }

    {{ if $THROTTLED }}
    error_page 418 = @throttle;

    location @throttle {
        internal;  # disallow direct access to this location from outside
        limit_req zone=bot_limit    burst=6 nodelay;
        limit_req zone=subnet_limit burst=8 nodelay;
        limit_req_status 429;    # Return 429 Too Many Requests when the limit is exceeded
        include uwsgi_params;
        proxy_pass http://pyoma;
        uwsgi_read_timeout 100;
    }
    {{- end }}

    # File downloads.
    # Files present on disk are served directly; absent files (large HDF5, etc.)
    # fall back to Django which records the download and redirects to Zenodo.
    location /All/ {
        # CORS preflight — must return 200 locally, never redirect
        # Note: redirect fallback to B2 only works in production (https)
        # On http://localhost the GET redirect works but CORS preflight fails
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin *;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS";
            add_header Access-Control-Allow-Headers *;
            add_header Access-Control-Max-Age 3600;
            return 204;
        }
        rewrite ^/All/(.*)$ /$1 break;
        root {{ getenv "DARWIN_BROWSERDOWNLOAD_PATH" }};
        add_header Access-Control-Allow-Origin *;
        try_files $uri @downloads_fallback;
    }

    # Specific versioned release directories: /All.Mar2026/, /Plants.Mar2026/, …
    # These are never present locally in the container, so go straight to the app.
    location ~ "^/[A-Za-z]+\.[A-Za-z]{3}\d{4}/" {
        add_header Access-Control-Allow-Origin *;
        proxy_pass http://pyoma;
        proxy_redirect off;
        proxy_read_timeout 10;
    }

    location @downloads_fallback {
        proxy_pass http://pyoma$request_uri;
        proxy_redirect off;
        proxy_read_timeout 10;
    }

    location /static/ {
        alias {{ getenv "DARWIN_BROWSERSTATIC_PATH" }}/;
    }

    location /media/ {
        alias {{ getenv "DARWIN_BROWSERMEDIA_PATH" }}/;
        gzip on;
        gzip_static always;
        gzip_proxied any;
        gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript chemical/x-fasta;
    }

    location / {
        alias {{ getenv "DARWIN_BROWSERSTATIC_PATH" }}/;
    }

}
