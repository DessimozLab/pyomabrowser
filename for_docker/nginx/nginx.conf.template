{{- $BEHIND_PROXY := getenv "REVERSE_PROXY_IP" | ne "" }}
{{- $log_rate_limit_file := getenv "LOG_RATE_LIMIT_FILE" }}
{{- $user_agent_bot_file := getenv "USER_AGENT_BOT_FILE" }}
{{- $subnet_bot_file := getenv "SUBNET_BOT_FILE" }}
{{- $nginx_snippet_path := getenv "NGINX_SNIPPET_PATH" "/etc/nginx/snippets" }}
{{- $THROTTLED := or ($log_rate_limit_file | ne "") (or ($user_agent_bot_file | ne "") ($subnet_bot_file | ne "")) }}
{{- $is_dev := eq ((getenv "DEPLOYMENT_TYPE") | strings.ToUpper | strings.Trunc 3) "DEV" }}
{{- $log_to_file := getenv "NGINX_LOG_TO_FILE" | default "false" | conv.ToBool }}
{{- $kc_issuer := getenv "OAUTH2_PROXY_OIDC_ISSUER_URL" }}
{{- $kc_client_id := getenv "OAUTH2_PROXY_CLIENT_ID" }}
{{- $kc_client_secret := getenv "OAUTH2_PROXY_CLIENT_SECRET" }}

upstream pyoma {
    server web:8000;
}

{{ if $BEHIND_PROXY }}
# pass incoming X-Forwarded-Proto or set to $scheme
map $http_x_forwarded_proto $proxyproto {
    default     $http_x_forwarded_proto;
    ""          $scheme;
}
{{ end }}

{{- if $THROTTLED }}
# Configure limit zones
limit_req_zone $bot_throttle_key zone=bot_limit:5m rate=6r/m;
limit_req_zone $subnet_key zone=subnet_limit:5m rate=6r/m;

map $http_user_agent $bot_throttle_key {
    default            "";         # Not a bot → no limit
    {{ $ua_file := printf "%s/%s"  $nginx_snippet_path  $user_agent_bot_file }}
    {{- if (file.Exists $ua_file) }}
    include    {{ $ua_file }};
    {{- end }}
}

geo $subnet_key {
    default         "";
    {{ $sb_file := printf "%s/%s"  $nginx_snippet_path $subnet_bot_file }}
    {{- if (file.Exists $sb_file) }}
    include    {{ $sb_file }};
    {{- end }}
    {{- if $log_rate_limit_file }}
    {{ $al_file := printf "%s/%s"  $nginx_snippet_path $log_rate_limit_file }}
    {{- if (file.Exists $al_file) }}
    include   {{ $al_file }};
    {{- end }}
    {{- end }}
}


map $request_uri $is_exempt_path {
    default                     0;
    ~^/oma/domains/[^/]+/json/  1;    # exclude domain json requests from throttling
}

map $bot_throttle_key $is_known_bot {
    ""      0;
    default 1;
}

map $subnet_key $is_throttle_subnet {
    ""      0;
    default 1;
}


map "$is_known_bot|$is_exempt_path|$is_throttle_subnet" $should_throttle {
    default   0;
    "1|0|0"   1;  # Bot AND not exempted → throttle
    "1|0|1"   1;  # Bot AND not exempted AND BadSubnet → throttle
    "0|0|1"   1;  # BadSubnet → throttle
    "0|1|1"   1;  # exempted AND BadSubnet → throttle
    "1|1|1"   1;  # Bot AND exempted AND BadSubnet → throttle
}
{{- end }}


server {
    listen 80;
    server_tokens off;

    {{ if $BEHIND_PROXY -}}
    # set proxy headers if run behind external proxy
    set_real_ip_from {{ getenv "REVERSE_PROXY_IP" }};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    {{- end }}

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    {{- if $BEHIND_PROXY }}
    proxy_set_header X-Forwarded-Proto $proxyproto;
    {{- else }}
    proxy_set_header X-Forwarded-Proto $scheme;
    {{- end }}

    # allow to upload files up to 55MB
    client_max_body_size 55M;

    # redirect / to home page
    rewrite ^/$ /oma/home/ permanent;
    rewrite ^/index.html$ /oma/home/ permanent;

    proxy_intercept_errors on;

    {{- if not $is_dev }}
    error_page   500 503 504  /50x.html;
    error_page   502          /502.html;
    error_page   429          /429.html;
    {{- end }}

    {{- if $log_to_file }}
    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;
    {{- end }}
    access_log /dev/stdout;
    error_log  /dev/stderr {{ if $is_dev -}} info {{- else -}} warn {{- end }};

    # Public token proxy: injects client credentials server-side for device flow
    location = /api/auth/device {
        proxy_pass {{ $kc_issuer }}/protocol/openid-connect/auth/device;
        proxy_set_header Content-Type "application/x-www-form-urlencoded";
        proxy_set_body "client_id={{ $kc_client_id }}&client_secret={{ $kc_client_secret }}";
        proxy_ssl_server_name on;
    }

    location = /api/auth/token {
        proxy_pass {{ $kc_issuer }}/protocol/openid-connect/token;
        proxy_set_header Content-Type "application/x-www-form-urlencoded";
        proxy_set_body "$request_body&client_id={{ $kc_client_id }}&client_secret={{ $kc_client_secret }}";
        proxy_ssl_server_name on;
    }

    # oauth2-proxy sign-in flow and callbacks
    location /oauth2/ {
        proxy_pass http://oauth2-proxy:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    # Internal auth check: passes browser AJAX from the same site (sec-fetch-site: same-origin),
    # forwards all other requests to oauth2-proxy for authentication.
    # Note: auth_request requires a literal URI, so the branching logic lives here.
    location = /_auth_check {
        internal;
        if ($http_sec_fetch_site = "same-origin") {
            return 200;
        }
        proxy_pass http://oauth2-proxy:4180/oauth2/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Public website pages — always accessible
    location ~ ^/oma/ {
        {{- if $THROTTLED }}
        if ($should_throttle)  {
            return 418;
        }
        {{- end }}
        proxy_pass http://pyoma;
        proxy_redirect off;
        uwsgi_read_timeout 100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Auth-Request-User $http_x_auth_request_user;
        proxy_set_header X-Auth-Request-Email $http_x_auth_request_email;
    }

    # REST API — browser AJAX from the website passes freely (sec-fetch-site: same-origin);
    # external HTTP clients (curl, scripts) require oauth2 authentication.
    # To make specific cheap endpoints public in the future, add a location block for
    # them above this one without auth_request (more-specific regex takes precedence).
    location ~ ^/api/ {
        {{- if $THROTTLED }}
        if ($should_throttle)  {
            return 418;
        }
        {{- end }}
        auth_request /_auth_check;
        auth_request_set $auth_user  $upstream_http_x_auth_request_user;
        auth_request_set $auth_email $upstream_http_x_auth_request_email;
        error_page 401 = @api_unauthorized;
        proxy_pass http://pyoma;
        proxy_redirect off;
        uwsgi_read_timeout 100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Auth-Request-User  $auth_user;
        proxy_set_header X-Auth-Request-Email $auth_email;
    }

    location @api_unauthorized {
        # Browser navigation gets redirected to the sign-in page.
        # External clients (curl, scripts) get a JSON 401.
        if ($http_sec_fetch_mode = "navigate") {
            return 302 /oauth2/sign_in?rd=$request_uri;
        }
        default_type application/json;
        return 401 '{"detail":"Authentication credentials were not provided."}';
    }

    location = /cgi-bin/gateway.pl {
        proxy_pass http://pyoma;
        proxy_redirect off;
        uwsgi_read_timeout 3;
    }

    {{ if $THROTTLED }}
    error_page 418 = @throttle;

    location @throttle {
        internal;  # disallow direct access to this location from outside
        limit_req zone=bot_limit    burst=6 nodelay;
        limit_req zone=subnet_limit burst=8 nodelay;
        limit_req_status 429;    # Return 429 Too Many Requests when the limit is exceeded
        include uwsgi_params;
        proxy_pass http://pyoma;
        uwsgi_read_timeout 100;
    }
    {{- end }}

    # File downloads.
    # Files present on disk are served directly; absent files (large HDF5, etc.)
    # fall back to Django which records the download and redirects to Zenodo.
    location /All/ {
        # CORS preflight — must return 200 locally, never redirect
        # Note: redirect fallback to B2 only works in production (https)
        # On http://localhost the GET redirect works but CORS preflight fails
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin *;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS";
            add_header Access-Control-Allow-Headers *;
            add_header Access-Control-Max-Age 3600;
            return 204;
        }
        rewrite ^/All/(.*)$ /$1 break;
        root {{ getenv "DARWIN_BROWSERDOWNLOAD_PATH" }};
        add_header Access-Control-Allow-Origin *;
        try_files $uri @downloads_fallback;
    }

    # Specific versioned release directories: /All.Mar2026/, /Plants.Mar2026/, …
    # These are never present locally in the container, so go straight to the app.
    location ~ "^/[A-Za-z]+\.[A-Za-z]{3}\d{4}/" {
        add_header Access-Control-Allow-Origin *;
        proxy_pass http://pyoma;
        proxy_redirect off;
        proxy_read_timeout 10;
    }

    location @downloads_fallback {
        proxy_pass http://pyoma$request_uri;
        proxy_redirect off;
        proxy_read_timeout 10;
    }

    location /static/ {
        alias {{ getenv "DARWIN_BROWSERSTATIC_PATH" }}/;
    }

    location /media/ {
        alias {{ getenv "DARWIN_BROWSERMEDIA_PATH" }}/;
        gzip on;
        gzip_static always;
        gzip_proxied any;
        gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript chemical/x-fasta;
    }

    location / {
        alias {{ getenv "DARWIN_BROWSERSTATIC_PATH" }}/;
    }

}
